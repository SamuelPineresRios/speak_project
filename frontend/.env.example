# ============================================================
# VOX — Variables de entorno
# Copia este archivo a .env.local y rellena tus valores:
#   cp .env.example .env.local
# .env.local está en .gitignore. NUNCA subas claves al repositorio.
# ============================================================

# --- Sesión -------------------------------------------------
# Firma del JWT de la cookie HttpOnly. Mínimo 32 caracteres aleatorios.
#   openssl rand -hex 32
# Rotarlo invalida todas las sesiones activas.
JWT_SECRET=

# --- PostgreSQL (Drizzle) -----------------------------------
# Base de datos local donde viven users, missions, guides y narrative_states.
#   createuser?  createdb vox
# El esquema se crea con:  npx drizzle-kit push
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/vox

# --- IA (OpenRouter) ----------------------------------------
# Evaluación de escritura y chat del tutor -> lib/ai.ts
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Opcionales ---------------------------------------------
# Emails con acceso a GET /api/admin/metrics (separados por coma).
ADMIN_EMAILS=

# development | production  (lo fija Next.js)
NODE_ENV=development
