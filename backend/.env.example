# ============================================================
# VOX — Backend
# Copia este archivo a .env.local y rellena tus valores:
#   cp .env.example .env.local
# .env.local está en .gitignore. NUNCA subas claves al repositorio.
# ============================================================

# --- Servidor -----------------------------------------------
PORT=4000
NODE_ENV=development

# --- PostgreSQL (Drizzle) -----------------------------------
# Base de datos local:
#   createdb vox
# El esquema se crea con:  npm run db:push -w @vox/backend
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/vox

# --- Sesión -------------------------------------------------
# Firma del JWT de la cookie HttpOnly. Mínimo 32 caracteres aleatorios.
#   openssl rand -hex 32
# Rotarlo invalida todas las sesiones activas.
JWT_SECRET=

# --- IA (Anthropic Claude) ----------------------------------
# Evaluación de escritura y chat del tutor.
# Si está vacía, las rutas de IA responden 503 en vez de fallar.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo de Claude. Si se omite, se usa el snapshot fijado de Haiku 4.5:
#   claude-haiku-4-5-20251001
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Opcionales ---------------------------------------------
# Emails con acceso a GET /api/admin/metrics (separados por coma).
ADMIN_EMAILS=
